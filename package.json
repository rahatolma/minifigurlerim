{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "dev:clean": "rm -rf .next && npm run dev",
    "dev:webpack": "NEXT_TURBOPACK=0 next dev -p 3004",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cevir": "npx tsx scripts/translate-i18n.ts",
    "predev": "node scripts/verify-env.mjs",
    "prebuild": "node scripts/verify-env.mjs",
    "test:e2e": "playwright test",
    "check:i18n-contract": "node scripts/check-i18n-contract.mjs",
    "verify:i18n": "npm run check:i18n-contract && npx tsc --noEmit && npx playwright test e2e/figures-page.contract.spec.ts",
    "preflight": "npm run check:i18n-contract && npx tsc --noEmit && npm run build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.0",
    "@sentry/nextjs": "10.46.0",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.100.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.1",
    "next-intl": "4.9.0",
    "oauth-1.0a": "^2.2.6",
    "openai": "^6.33.0",
    "posthog-js": "1.364.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@swc/helpers": "^0.5.15"
  }
}
